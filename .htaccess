<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Document root proje klasörü olursa istekler yalnızca public içinden cevaplanır.
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "(^\.env|composer\.(json|lock|phar)|artisan|fix_columns\.php|server\.php)$">
    Require all denied
</FilesMatch>
