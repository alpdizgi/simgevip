<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # CVE-2024-4577 Savunması (PHP CGI Argument Injection Koruması)
    RewriteCond %{QUERY_STRING} ^%ad [NC,OR]
    RewriteCond %{QUERY_STRING} (%ad|%2d|\-)(d|s|u|w|T) [NC,OR]
    RewriteCond %{QUERY_STRING} auto_prepend_file [NC,OR]
    RewriteCond %{QUERY_STRING} allow_url_include [NC]
    RewriteRule .* - [F,L]

    # Redirect the live domain to HTTPS before routing into public.
    RewriteCond %{HTTP_HOST} ^(www\.)?simgegiyim\.com\.tr$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://simgegiyim.com.tr%{REQUEST_URI} [R=301,L]

    # Document root proje klasörü olursa istekler yalnızca public içinden cevaplanır.
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "(^\.env|^\.git|composer\.(json|lock|phar)|package\.(json|lock)|artisan|server\.php|\.(sql|bak|dump|old|log|ini|sh|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
